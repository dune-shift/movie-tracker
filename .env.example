# TMDB API Read Access Token (v4 auth) — NOT the shorter v3 API Key
# Get yours at: https://www.themoviedb.org/settings/api
# Copy the "API Read Access Token (v4 auth)" — it starts with "eyJ" and is ~200 characters long
VITE_TMDB_API_KEY=your_tmdb_read_access_token_here

# Supabase project credentials
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key_here
